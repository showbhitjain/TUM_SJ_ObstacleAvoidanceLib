%Robot is rigidbodytree object
%getTransform(frankarobot_mdh,frankarobot_mdh.homeConfiguration,'Franka_link7','base')
function Jacobimatrix = jacobian_cartesian(robot, config, to_ith_link)
%config  = homeConfiguration(robot);
numJoints = length(jointValues); % Number of joints
disp(config)
config = jointValues;
% for i = 1:numJoints 
% config(i).JointPosition = jointValues(i);
% end 
J = zeros(6, numJoints); % Initialize Jacobian matrix with zeros
    
    if to_ith_link == 8 
        T_end_effector = robot.getTransform(robot,config, 'Gripper_TCP','base');
    else
    % Compute the transformation to the end-effector or to_ith_link
    T_end_effector = robot.getTransform(robot,config, ['Franka_link',num2str(i)],'base');
    end
    
    end_effector_position = T_end_effector(1:3, 4);

    for i = 1:to_ith_link-1
        % Get the transformation matrix from the base frame to the ith joint
        T_i = robot.getTransform(robot,config, ['Franka_link',num2str(i)],'base');

        % Extract the z-axis of the ith joint in base frame coordinates
        z_i = T_i(1:3, 1:3) * [0; 0; 1];

        % Position of the ith joint in base frame coordinates
        d_i = T_i(1:3, 4);

        % Linear velocity contribution: cross product of z-axis with the vector from joint i to the end-effector
        Jv_i = cross(z_i, (end_effector_position - d_i));

        % Angular velocity contribution: simply the z-axis for revolute joints
        Jw_i = z_i;

        % Fill in the ith column of the Jacobian matrix for joint i
        J(1:3, i) = Jv_i; % Upper part for linear velocity
        J(4:6, i) = Jw_i; % Lower part for angular velocity
    end

    % Columns of Jacobian corresponding to joints beyond to_ith_link are already initialized to zero
    Jacobimatrix = J;
end
