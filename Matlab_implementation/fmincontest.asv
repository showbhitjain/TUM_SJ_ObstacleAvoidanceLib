% 
% function [val, gradient] = objective_function(q_vel)
%     val = 1/2 * q*q' + ;
%     if (nargout > 1)
%         gradient = [0, 0.5 / val];
%     end

%qvel is joint velocity row;
% lb = parameter used to control the response amplitude of 
% the robot manipulator to joint displacement of the current state and the initial state,
objective = @(q_vel) (1-delta-alpha)  * (norm(q_vel, Inf)^2) / 2 + ... % infinity norm term
                       delta * (norm(q_vel, 2)^2 )/ 2 + ... % two-norm term
                       alpha * ((q_vel * eye(length(q_vel))*q_vel') + 2* lb * q_vel  ) / 2 + ...
                       beta * 1/(1 + sqrt(det(jacobi' * jacobi))); % additional term from Eq. (2.17)


A = []; b = []; % No linear inequality constraints
Aeq = Je; beq = xd_eff_vel; % No linear equality constraints

%gamma is a positive parameter used to control the range of q_vel
lb = max(gamma*(jointminvalues - joint_values),joint_min_vel); % Lower bound from Eq. (2.14)
ub = min(gamma*(jointmaxvalues - joint_values),joint_max_vel);; % Upper bound from Eq. (2.15)

% Define the nonlinear constraint function
% nonlcon = @(theta) deal(... % Use 'deal' to output both C and Ceq for fmincon
%     Jc(theta) - bc, ... % Inequality constraints from Eq. (2.13)
%     Je(theta) - re ... % Equality constraints from Eq. (2.12)
% );

% Set up optimization options (optional)
options = optimoptions('fmincon', 'Algorithm', 'interior-point', ... % Choose an algorithm
                       'Display', 'iter', ... % Display iterations
                       'MaxIterations', 1000, ... % Maximum number of iterations
                       'ConstraintTolerance', 1e-6); % Constraint tolerance
opts = optimoptions('fmincon','Algorithm','sqp');
% Initial guess for theta
theta0 = currentconfig... % You need to provide an initial guess

% Run the optimization
[theta_opt, fval] = fmincon(objective, theta0, A, b, Aeq, beq, lb, ub, nonlcon, options);

% Output the results
disp('Optimal theta:');
disp(theta_opt);
disp('Objective function value at optimal theta:');
disp(fval);