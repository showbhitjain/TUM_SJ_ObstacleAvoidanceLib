# CompilerName=gcc
# Mode=optim
ninja_required_version = 1.3

# Basic folders
root = .
builddir = $root/build/glnxa64
matlabdir = /usr/local/MATLAB/R2023b
startdir = /home/shobhit/Franka-emika-Obstacle-avoidance/ObstacleAvoidance/robotmodelling/Matlab_implementation

# Toolchain information
cc = /usr/bin/gcc
cxx = g++
linker = /usr/bin/gcc
linkerxx = g++

cflags =  -fexceptions -fPIC -fno-omit-frame-pointer -pthread -fwrapv -D_GNU_SOURCE -DMATLAB_MEX_FILE  -O2 -DNDEBUG -std=c99 -I "$root" -I "$startdir" -I "$root/interface" -I "$matlabdir/extern/include" -I "." -DMODEL=Jacobi_final_link1_mex -msse2 -c 

cxxflags =  -fexceptions -fPIC -fno-omit-frame-pointer -pthread -fwrapv -D_GNU_SOURCE -DMATLAB_MEX_FILE  -O2 -DNDEBUG -std=c++11 -I "$root" -I "$startdir" -I "$root/interface" -I "$matlabdir/extern/include" -I "." -DMODEL=Jacobi_final_link1_mex -msse2 -c 

ldflags =  -pthread -Wl,--no-undefined -Wl,-rpath-link,$matlabdir/bin/glnxa64 -shared  -L"$matlabdir/bin/glnxa64" -lmx -lmex -lmat -lm -lstdc++  -Wl,-Bsymbolic -o Jacobi_final_link1_mex.mexa64 -lemlrt -lcovrt -lut -lmwmathutil  -Wl,--version-script,Jacobi_final_link1_mex.map

linkobjs = 

# Build Rules
rule cc
    command = $cc $cflags $in -o $out

rule cxx
    command = $cxx $cxxflags $in -o $out

rule link
    command = $linker $in $linkobjs $ldflags

rule linkxx
    command = $linkerxx $in $linkobjs $ldflags

# Build
build $builddir/Jacobi_final_link1_data.o : cc $root/Jacobi_final_link1_data.c
build $builddir/rt_nonfinite.o : cc $root/rt_nonfinite.c
build $builddir/Jacobi_final_link1_initialize.o : cc $root/Jacobi_final_link1_initialize.c
build $builddir/Jacobi_final_link1_terminate.o : cc $root/Jacobi_final_link1_terminate.c
build $builddir/Jacobi_final_link1.o : cc $root/Jacobi_final_link1.c
build $builddir/_coder_Jacobi_final_link1_api.o : cc $root/interface/_coder_Jacobi_final_link1_api.c
build $builddir/_coder_Jacobi_final_link1_mex.o : cc $root/interface/_coder_Jacobi_final_link1_mex.c
build $builddir/_coder_Jacobi_final_link1_info.o : cc $root/interface/_coder_Jacobi_final_link1_info.c
build $builddir/c_mexapi_version.o : cc $matlabdir/extern/version/c_mexapi_version.c

# Link
build $root/Jacobi_final_link1_mex.mexa64 : link $builddir/Jacobi_final_link1_data.o $builddir/rt_nonfinite.o $builddir/Jacobi_final_link1_initialize.o $builddir/Jacobi_final_link1_terminate.o $builddir/Jacobi_final_link1.o $builddir/_coder_Jacobi_final_link1_api.o $builddir/_coder_Jacobi_final_link1_mex.o $builddir/_coder_Jacobi_final_link1_info.o $builddir/c_mexapi_version.o 
