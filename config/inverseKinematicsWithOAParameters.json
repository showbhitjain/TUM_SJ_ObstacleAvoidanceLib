{
  "parametersFor": "inverseKinematicsWithOA",
  "ObjectiveConstraints": {
    "useObjectiveNormInfinity": false,
    "weightNormInfinity": 0.1,
    "useObjectiveNormL2": true,
    "weightNormL2": 1,
    "jointVelocityWeight": [1,1,1,1,1,1,1],
    "useObjectiveTrajectoryFollowing": false,
    "weightTrajectoryFollowing": 0.1,
    "useObjectiveJointAcceleration": false,
    "weightJointAcceleration": 0.1,
    "useObjectiveManipulability": false,
    "weightManipulability": 0.1
  },
  "EquationParameters": {
    "applyEqualityConstraints":true,
    "applyInequalityConstraints": true
  },
  "SlackParameters": {
    "applySlack": true,
    "Slacklowerbound": [-0.2,-0.2,-0.1,-2,-2,-60],
    "Slackupperbound": [0.2,0.2,0.1,2,2,60],
     "SlackPenaltyWeight": [1,1,1,1,1,0.5],
    "SlackObjectiveWeight": 20
  },
  "jointLimitAvoidanceParameters": {
    "gamma": 2,
    "applyVelocityDamper": true,
    "jointLimitActivationDistance": 10,
    "jointLimitStopDistance": 3,
    "jointLimitGain": 1
  }
}